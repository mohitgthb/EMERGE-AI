// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  role         String   @default("ADMIN")
  refreshToken String?
  createdAt    DateTime @default(now())
}

model SOSEvent {
  id            String   @id @default(uuid())
  latitude      Float
  longitude     Float
  emergencyType String   //MEDICAL || SAFETY || FIRE || ACCIDENT
  severity      String   @default("HIGH")
  
  imageUrl      String?
  deviceIP      String?
  deviceMAC     String?
  userAgent     String?
  deviceFingerprint String?
  
  isVerified    Boolean  @default(false)
  verificationMethod String? //AI || MANUAL
  status        String   @default("PENDING") //PENDING || CONFIRMED || REJECTED || ESCALATED
  
  lastSOSAt     DateTime?
  sosCount      Int      @default(0)

  // Incident clustering
  clusterId     String?  // UUID of the parent/primary incident in cluster
  clusterCount  Int      @default(1)
  severityScore Int      @default(1) // incremented for each merged report
  
  createdAt     DateTime @default(now())
  
  policeDispatch PoliceDispatch?
}

model Accident {
  id            String   @id @default(uuid())
  latitude      Float
  longitude     Float
  severity      String   
  detectedBy    String   
  confidence    Float?
  cameraId      String?
  emergencyType String   @default("ACCIDENT") //ACCIDENT || FIRE || MEDICAL
  createdAt     DateTime @default(now())

  dispatch      Dispatch?
  queueEntry    EmergencyQueue?
}

model FireIncident {
  id         String   @id @default(uuid())
  latitude   Float
  longitude  Float
  severity   String
  detectedBy String
  confidence Float?
  cameraId   String?
  createdAt  DateTime @default(now())

  dispatch   FireDispatch?
  queueEntry EmergencyQueue?
}

model EmergencyQueue {
  id            String   @id @default(uuid())
  emergencyType String   //ACCIDENT || FIRE
  emergencyId   String   @unique
  confidence    Float
  severity      String
  latitude      Float
  longitude     Float
  status        String   @default("PENDING") //PENDING || CONFIRMED || REJECTED
  assignedTo    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  
  accident      Accident?     @relation(fields: [emergencyId], references: [id], map: "EmergencyQueue_accident_fkey")
  fireIncident  FireIncident? @relation(fields: [emergencyId], references: [id], map: "EmergencyQueue_fire_fkey")
}

model Ambulance {
  id         String  @id @default(uuid())
  vehicleNo  String  @unique
  latitude   Float
  longitude  Float
  status     String  //available || busy || EN_ROUTE || ARRIVED
  updatedAt  DateTime  @updatedAt

  dispatches Dispatch[]
}

model Hospital {
  id         String  @id @default(uuid())
  name       String
  latitude   Float
  longitude  Float
  beds       Int
  updatedAt  DateTime  @updatedAt

  dispatches Dispatch[]
  operators  Operator[]
}

model Dispatch {
  id          String  @id @default(uuid())
  accidentId  String  @unique
  ambulanceId String
  hospitalId  String

  status       String   @default("ACTIVE") // ACTIVE | EN_ROUTE | ARRIVED | FAILED_ASSIGNMENT | REASSIGNED | COMPLETED
  reassignCount Int     @default(0)
  replacedById  String? // ID of new dispatch if this one was reassigned

  startTime   DateTime @default(now())
  endtime     DateTime?

  routeProvider    String?
  routeDistanceKm  Float?
  routeDurationSec Int?
  routeGeometry    Json?

  // Hospital route (incident → hospital)
  hospitalRouteProvider    String?
  hospitalRouteDistanceKm  Float?
  hospitalRouteDurationSec Int?
  hospitalRouteGeometry    Json?

  accident    Accident  @relation(fields: [accidentId], references: [id])
  ambulance   Ambulance @relation(fields: [ambulanceId], references: [id])
  hospital    Hospital  @relation(fields: [hospitalId], references: [id])
}

model FireDispatch {
  id             String   @id @default(uuid())
  fireIncidentId String   @unique
  fireBrigadeId  String
  
  status         String   @default("ACTIVE") // ACTIVE | FAILED_ASSIGNMENT | REASSIGNED | COMPLETED
  reassignCount  Int      @default(0)
  replacedById   String?

  startTime      DateTime @default(now())
  endtime        DateTime?
  
  routeProvider    String?
  routeDistanceKm  Float?
  routeDurationSec Int?
  routeGeometry    Json?

  fireIncident   FireIncident @relation(fields: [fireIncidentId], references: [id])
  fireBrigade    FireBrigade  @relation(fields: [fireBrigadeId], references: [id])
}

model PoliceDispatch {
  id           String   @id @default(uuid())
  sosEventId   String   @unique
  policeUnitId String
  
  status       String   @default("ACTIVE") // ACTIVE | FAILED_ASSIGNMENT | REASSIGNED | COMPLETED
  reassignCount Int     @default(0)
  replacedById  String?

  startTime    DateTime @default(now())
  endtime      DateTime?
  
  routeProvider    String?
  routeDistanceKm  Float?
  routeDurationSec Int?
  routeGeometry    Json?

  sosEvent     SOSEvent @relation(fields: [sosEventId], references: [id])
  policeUnit   PoliceUnit @relation(fields: [policeUnitId], references: [id])
}

model TrafficSignal {
  id         String @id @default(uuid())
  junctionId String @unique
  latitude   Float
  longitude  Float
  state      String //RED|| GREEN || NORMAL
  updatedAt  DateTime @updatedAt
}

model FireBrigade {
  id         String   @id @default(uuid())
  vehicleNo  String   @unique
  latitude   Float
  longitude  Float
  status     String   //AVAILABLE || BUSY || EN_ROUTE || ARRIVED
  updatedAt  DateTime @updatedAt

  dispatches FireDispatch[]
}

model PoliceUnit {
  id         String   @id @default(uuid())
  vehicleNo  String   @unique
  latitude   Float
  longitude  Float
  status     String   //AVAILABLE || BUSY || EN_ROUTE || ARRIVED
  updatedAt  DateTime @updatedAt

  dispatches PoliceDispatch[]
}

model Camera {
  id          String   @id @default(uuid())
  cameraId    String   @unique
  name        String
  location    String
  latitude    Float
  longitude   Float
  rtspUrl     String?
  videoPath   String?
  streamType  String   @default("RTSP")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Operator {
  id           String   @id @default(uuid())
  operatorId   String   @unique          // login username e.g. "AMB-001"
  password     String                    // bcrypt hash
  name         String
  role         String                    // AMBULANCE | FIRE_BRIGADE | POLICE | HOSPITAL | ADMIN
  vehicleId    String?  @unique          // FK to Ambulance/FireBrigade/PoliceUnit id
  hospitalId   String?  @unique          // FK to Hospital id (for HOSPITAL role)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hospital     Hospital? @relation(fields: [hospitalId], references: [id])
}

model StatusHistory {
  id          String   @id @default(uuid())
  dispatchId  String                   // references any dispatch type
  dispatchType String                  // ACCIDENT | FIRE | POLICE
  vehicleId   String
  vehicleType String                   // AMBULANCE | FIRE_BRIGADE | POLICE
  status      String                   // EN_ROUTE | ARRIVED | COMPLETED etc
  latitude    Float?
  longitude   Float?
  timestamp   DateTime @default(now())

  @@index([dispatchId])
  @@index([vehicleId])
}

// ─── Predictive Emergency Readiness ─────────────────────────────────────────
model RiskZone {
  id              String   @id @default(uuid())
  gridKey         String   @unique            // "lat_lng" grid cell identifier
  centerLat       Float
  centerLng       Float
  riskScore       Float    @default(0)
  incidentScore   Float    @default(0)
  densityScore    Float    @default(0)
  timeScore       Float    @default(0)
  incidentCount   Int      @default(0)
  avgDensity      Float    @default(0)
  peakHour        Int?                        // 0-23 hour with highest incident rate
  reasons         String[]                    // ["High past accidents", "High vehicle density", ...]
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  suggestions     StandbySuggestion[]

  @@index([riskScore])
}

model DensitySummary {
  id              String   @id @default(uuid())
  cameraId        String
  latitude        Float
  longitude       Float
  vehicleCount    Int      @default(0)
  avgDensity      Float    @default(0)
  windowStart     DateTime
  windowEnd       DateTime
  createdAt       DateTime @default(now())

  @@index([cameraId])
  @@index([windowStart, windowEnd])
}

model StandbySuggestion {
  id                  String   @id @default(uuid())
  riskZoneId          String
  vehicleId           String
  vehicleType         String                // AMBULANCE | FIRE_BRIGADE
  vehicleNo           String
  currentLat          Float
  currentLng          Float
  suggestedLat        Float
  suggestedLng        Float
  distanceKm          Float
  responseTimeImprove Float                  // estimated seconds saved
  status              String   @default("PENDING") // PENDING | ACCEPTED | DISMISSED | EXPIRED
  createdAt           DateTime @default(now())
  expiresAt           DateTime

  riskZone            RiskZone @relation(fields: [riskZoneId], references: [id])

  @@index([riskZoneId])
  @@index([vehicleId])
  @@index([status])
}

// ─── Connected Vehicle Crash Alert ──────────────────────────────────────────
model VehicleCrash {
  id              String   @id @default(uuid())
  vehicleRegNo    String                        // e.g. "MH-12-CAR-009"
  latitude        Float
  longitude       Float
  severity        String                        // LOW | MEDIUM | HIGH | CRITICAL
  airbagDeployed  Boolean  @default(true)
  source          String   @default("VEHICLE_SENSOR") // VEHICLE_SENSOR | MANUAL
  status          String   @default("REPORTED")       // REPORTED | DISPATCHED | CANCELLED | DUPLICATE
  accidentId      String?  @unique              // links to the Accident created from this crash
  dispatchId      String?                       // the resulting dispatch ID
  cancelledAt     DateTime?
  idempotencyKey  String?  @unique              // vehicleRegNo + 5-min window key for dedup
  createdAt       DateTime @default(now())

  @@index([vehicleRegNo])
  @@index([status])
  @@index([createdAt])
}

